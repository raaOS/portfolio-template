# =============================================================================
# Portfolio OS Template - Full Cloudflare Environment Contract
# =============================================================================
# Copy to .env.local for local development. Never commit real values.
# This template repo must not require personal messaging/contact credentials.

# -----------------------------------------------------------------------------
# Public browser-accessible values
# -----------------------------------------------------------------------------
# Base URL untuk link yang dikirim ke pembeli via email/Telegram (struk,
# aktivasi, notifikasi). Di luar development, nilai localhost/loopback
# otomatis diabaikan oleh getPublicBaseUrl (src/lib/constants.ts) agar
# email produksi tidak pernah menautkan pembeli ke link mati.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Canonical URL untuk SEO (sitemap/robots/preview) — juga fallback kedua
# getPublicBaseUrl bila NEXT_PUBLIC_APP_URL kosong/loopback.
NEXT_PUBLIC_SITE_URL=""
NEXT_PUBLIC_PRODUCT_NAME="Portfolio OS Template"
NEXT_PUBLIC_DATA_BACKEND="cloudflare-d1"
NEXT_PUBLIC_DEV_VITALS=""
# Browser FFmpeg core files are served from R2 through the app's read-only
# `/r2/ffmpeg/*` proxy. Upload `public/ffmpeg/*` to R2 keys `ffmpeg/*`.
NEXT_PUBLIC_FFMPEG_BASE_URL="/r2/ffmpeg"
# Nomor WhatsApp admin (format internasional tanpa '+', contoh: 62812...).
# Dipakai tombol "Hubungi Admin" pada halaman struk order storefront
# (src/app/orders/[orderId]/page.tsx). Bila kosong memakai nilai fallback.
NEXT_PUBLIC_ADMIN_WA=""

# -----------------------------------------------------------------------------
# Cloudflare account and data backend
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=""

# Safety guard for live Cloudflare mutations.
# Set to "true" only after .env.local points to the new product Cloudflare account.
PRODUCT_CLOUDFLARE_ENV_CONFIRMED="false"

# D1 databases for the product account, not the old personal portfolio account.
CLOUDFLARE_D1_DATABASE_ID=""
CLOUDFLARE_D1_API_TOKEN=""
# Optional staging/restore database used by Sprint 44 backup/restore drills.
# Never point this to production during normal drills.
CLOUDFLARE_D1_RESTORE_DATABASE_ID=""

# R2 bucket for product media. Scope all object keys by site:
# sites/{siteId}/projects/{projectId}/{mediaId}-{variant}.{ext}
# Runtime uploads/downloads use the Cloudflare Worker R2 binding in wrangler.jsonc.
# Keep this as MEDIA_BUCKET unless you also change wrangler.jsonc.
CLOUDFLARE_R2_BINDING="MEDIA_BUCKET"
# Optional override when R2 lives in a different account than CLOUDFLARE_ACCOUNT_ID.
# S3-compatible access keys are still used by maintenance scripts and CLI tasks.
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET=""
CLOUDFLARE_R2_PUBLIC_BASE_URL=""
# Opsi bila D1/R2 berada di akun berbeda dari CLOUDFLARE_ACCOUNT_ID (fallback;
# dibiarkan kosong agar memakai CLOUDFLARE_ACCOUNT_ID). Dipakai script
# maintenance, backup, dan monitoring.
CLOUDFLARE_D1_ACCOUNT_ID=""
# Token API Cloudflare umum — hanya sebagai fallback token purge cache bila
# CLOUDFLARE_CACHE_PURGE_TOKEN kosong (lihat src/lib/cache/clearApplicationCache.ts).
CLOUDFLARE_API_TOKEN=""

# Zona & token purge cache Cloudflare (opsional).
# CLOUDFLARE_ZONE_ID wajib terisi bila FEATURE_CUSTOM_DOMAIN=true (custom domain
# dipasang di zona ini) atau bila fitur purge CDN dipakai
# (src/lib/services/customDomainService.ts, src/lib/cache/clearApplicationCache.ts).
CLOUDFLARE_ZONE_ID=""
# Alias lama untuk CLOUDFLARE_ZONE_ID (dibiarkan kosong kecuali perlu kompatibilitas).
CLOUDFLARE_CACHE_ZONE_ID=""
CLOUDFLARE_CACHE_PURGE_TOKEN=""

DATA_BACKEND="cloudflare-d1"

# -----------------------------------------------------------------------------
# Auth and security
# -----------------------------------------------------------------------------
JWT_SECRET=""
PASSWORD_SALT=""
ADMIN_PASSWORD_SCRYPT=""
ADMIN_PIN=""
REVALIDATION_TOKEN=""
# Token untuk cron trigger harian (wrangler.jsonc `crons` -> POST /api/cron/daily).
# Kosongkan hanya bila Anda memang tidak ingin cron harian berjalan.
CRON_SECRET=""

# -----------------------------------------------------------------------------
# Product feature gates
# -----------------------------------------------------------------------------
FEATURE_AI="false"
FEATURE_NOTIFICATIONS="false"
FEATURE_CUSTOM_DOMAIN="false"
FEATURE_ANALYTICS="false"

# -----------------------------------------------------------------------------
# Deployment role (pemilah toko vs website klien)
# -----------------------------------------------------------------------------
# "true" HANYA untuk build storefront owner (halaman jualan tampil di `/`).
# Website klien: kosong/false — `/` merender portofolio milik klien.
# Build klien otomatis mengosongkan kunci ini (fail-closed, lihat
# scripts/onboarding/client-deploy.ts) supaya tidak pernah bocor.
STOREFRONT="false"

# Owner Mode (superadmin) — "true" HANYA di deployment milik owner sendiri.
# Mengaktifkan app desktop admin `ownerOnly` (Harga Jual, Order & Pembayaran)
# dan route API-nya (/api/admin/pricing, /api/admin/orders). Selalu pasangkan
# dengan NEXT_PUBLIC_OWNER_MODE=nilai sama (lihat src/lib/ownerMode.ts).
# Website klien: selalu false — build klien memaksa kedua kunci ini 'false'
# di scripts/onboarding/client-deploy.ts (fail-closed), jadi tool owner tidak
# pernah terlihat/terjangkar di site klien.
OWNER_MODE="false"
NEXT_PUBLIC_OWNER_MODE="false"

# -----------------------------------------------------------------------------
# Optional platform AI
# -----------------------------------------------------------------------------
# These are platform-owned product keys, not personal portfolio keys.
# Keep blank unless FEATURE_AI=true.
AI_PROVIDER=""
AI_API_KEY=""
# Override opsional base URL & model untuk provider AI. Kosongkan untuk memakai
# nilai default per provider (lihat DEFAULT_BASE_URLS/DEFAULT_MODELS di
# src/lib/services/aiGatewayService.ts). Hanya relevan bila FEATURE_AI=true.
AI_BASE_URL=""
AI_MODEL=""

# -----------------------------------------------------------------------------
# Optional generic notification provider
# -----------------------------------------------------------------------------
# Supported provider: NOTIFICATION_PROVIDER="resend"
NOTIFICATION_PROVIDER=""
NOTIFICATION_API_KEY=""
NOTIFICATION_DEFAULT_FROM=""

# -----------------------------------------------------------------------------
# Optional Telegram Billing Admin Bot (1-Click Activation & Notifications)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_BOT_SECRET=""

# -----------------------------------------------------------------------------
# Optional production monitoring and alerting
# -----------------------------------------------------------------------------
MONITORING_TARGET_URL=""
MONITORING_SITE_SLUG="urgent"
MONITORING_HTTP_TIMEOUT_MS="10000"
MONITORING_STORAGE_WARN_RATIO="0.8"
# Supported values: none, console, webhook, resend.
MONITORING_ALERT_PROVIDER="none"
MONITORING_ALERT_WEBHOOK_URL=""
MONITORING_ALERT_RESEND_API_KEY=""
MONITORING_ALERT_FROM=""
MONITORING_ALERT_TO=""

# -----------------------------------------------------------------------------
# Optional load-test tooling
# -----------------------------------------------------------------------------
# Do not enable live load tests until monitoring has a full operational pass.
LOAD_TEST_TARGET_URL=""
LOAD_TEST_CONFIRM_HOST=""
LOAD_TEST_RUN_ID=""
LOAD_TEST_TENANTS="5"
LOAD_TEST_CONCURRENCY="3"
LOAD_TEST_EMAIL_DOMAIN="example.invalid"
LOAD_TEST_TIMEOUT_MS="30000"
LOAD_TEST_ADMIN_TOKEN=""
LOAD_TEST_ADMIN_PASSWORD=""

# -----------------------------------------------------------------------------
# Site quota defaults (nilai bawaan; bisa dioverride per site)
# -----------------------------------------------------------------------------
PROJECT_LIMIT="50"
STORAGE_MB="5000"
MEDIA_PER_PROJECT="50"

# -----------------------------------------------------------------------------
# Tooling / build-time flags
# -----------------------------------------------------------------------------
ANALYZE=""
