# =============================================================================
# Portfolio OS Template - Full Cloudflare Environment Contract
# =============================================================================
# Copy to .env.local for local development. Never commit real values.
# This template repo must not require personal messaging/contact credentials.

# -----------------------------------------------------------------------------
# Public browser-accessible values
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL=""
NEXT_PUBLIC_PRODUCT_NAME="Portfolio OS Template"
NEXT_PUBLIC_DATA_BACKEND="cloudflare-d1"
NEXT_PUBLIC_DEV_VITALS=""
# Browser FFmpeg core files are served from R2 through the app's read-only
# `/r2/ffmpeg/*` proxy. Upload `public/ffmpeg/*` to R2 keys `ffmpeg/*`.
NEXT_PUBLIC_FFMPEG_BASE_URL="/r2/ffmpeg"

# -----------------------------------------------------------------------------
# Cloudflare account and data backend
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=""

# Safety guard for live Cloudflare mutations.
# Set to "true" only after .env.local points to the new product Cloudflare account.
PRODUCT_CLOUDFLARE_ENV_CONFIRMED="false"

# D1 databases for the product account, not the old personal portfolio account.
CLOUDFLARE_D1_DATABASE_ID=""
CLOUDFLARE_D1_API_TOKEN=""
# Optional staging/restore database used by Sprint 44 backup/restore drills.
# Never point this to production during normal drills.
CLOUDFLARE_D1_RESTORE_DATABASE_ID=""

# R2 bucket for product media. Scope all object keys by site:
# sites/{siteId}/projects/{projectId}/{mediaId}-{variant}.{ext}
# Runtime uploads/downloads use the Cloudflare Worker R2 binding in wrangler.jsonc.
# Keep this as MEDIA_BUCKET unless you also change wrangler.jsonc.
CLOUDFLARE_R2_BINDING="MEDIA_BUCKET"
# Optional override when R2 lives in a different account than CLOUDFLARE_ACCOUNT_ID.
# S3-compatible access keys are still used by maintenance scripts and CLI tasks.
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET=""
CLOUDFLARE_R2_PUBLIC_BASE_URL=""

DATA_BACKEND="cloudflare-d1"

# -----------------------------------------------------------------------------
# Auth and security
# -----------------------------------------------------------------------------
JWT_SECRET=""
PASSWORD_SALT=""
ADMIN_PASSWORD_SCRYPT=""
ADMIN_PIN=""
REVALIDATION_TOKEN=""
FEATURE_CLIENT_PASSWORD_RESET="true"
CLIENT_PASSWORD_RESET_TOKEN_TTL_MINUTES="30"

# -----------------------------------------------------------------------------
# Product feature gates
# -----------------------------------------------------------------------------
FEATURE_CLIENT_DASHBOARD="true"
FEATURE_MASTER_DASHBOARD="true"
FEATURE_AI="false"
FEATURE_NOTIFICATIONS="false"
FEATURE_CUSTOM_DOMAIN="false"
FEATURE_ANALYTICS="false"

# -----------------------------------------------------------------------------
# Optional platform AI for Pro plan
# -----------------------------------------------------------------------------
# These are platform-owned product keys, not personal portfolio keys.
# Keep blank unless FEATURE_AI=true.
AI_PROVIDER=""
AI_API_KEY=""
AI_MONTHLY_TOKEN_LIMIT_LITE="0"
AI_MONTHLY_TOKEN_LIMIT_PRO=""

# -----------------------------------------------------------------------------
# Optional generic notification provider
# -----------------------------------------------------------------------------
# Supported provider: NOTIFICATION_PROVIDER="resend"
NOTIFICATION_PROVIDER=""
NOTIFICATION_API_KEY=""
NOTIFICATION_DEFAULT_FROM=""

# -----------------------------------------------------------------------------
# Optional Telegram Billing Admin Bot (1-Click Activation & Notifications)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_BOT_SECRET=""

# -----------------------------------------------------------------------------
# Optional production monitoring and alerting
# -----------------------------------------------------------------------------
MONITORING_TARGET_URL=""
MONITORING_SITE_SLUG="urgent"
MONITORING_HTTP_TIMEOUT_MS="10000"
MONITORING_STORAGE_WARN_RATIO="0.8"
# Supported values: none, console, webhook, resend.
MONITORING_ALERT_PROVIDER="none"
MONITORING_ALERT_WEBHOOK_URL=""
MONITORING_ALERT_RESEND_API_KEY=""
MONITORING_ALERT_FROM=""
MONITORING_ALERT_TO=""

# -----------------------------------------------------------------------------
# Optional load-test tooling
# -----------------------------------------------------------------------------
# Do not enable live load tests until monitoring has a full operational pass.
LOAD_TEST_TARGET_URL=""
LOAD_TEST_CONFIRM_HOST=""
LOAD_TEST_RUN_ID=""
LOAD_TEST_TENANTS="5"
LOAD_TEST_CONCURRENCY="3"
LOAD_TEST_EMAIL_DOMAIN="example.invalid"
LOAD_TEST_TIMEOUT_MS="30000"
LOAD_TEST_ADMIN_TOKEN=""
LOAD_TEST_ADMIN_PASSWORD=""

# -----------------------------------------------------------------------------
# Plan defaults
# -----------------------------------------------------------------------------
PLAN_LITE_PROJECT_LIMIT="5"
PLAN_LITE_STORAGE_MB="250"
PLAN_LITE_MEDIA_PER_PROJECT="8"
PLAN_PRO_PROJECT_LIMIT="50"
PLAN_PRO_STORAGE_MB="5000"
PLAN_PRO_MEDIA_PER_PROJECT="50"

# -----------------------------------------------------------------------------
# Tooling / build-time flags
# -----------------------------------------------------------------------------
ANALYZE=""
