{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-os-template",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-28",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "portfolio-template-media"
    }
  ],
  // Binding D1.
  //
  // Sebelumnya Worker memanggil database-nya SENDIRI lewat fetch() ke
  // api.cloudflare.com. Itu terhitung subrequest eksternal — batas 50 per
  // invokasi pada paket Free — dan terbukti membuat cron harian gagal menyimpan
  // hasil probe dengan pesan "Too many subrequests by single Worker invocation"
  // (2026-10-23, lihat docs/tracker/logs/worker_health_daily_probe_2026_10_23.md).
  //
  // Lewat binding, operasi D1 menjadi subrequest internal (batas 1.000) dan
  // tidak lagi membayar round-trip HTTP ~200-400ms. Jalur REST di
  // `src/lib/cloudflareD1.ts` tetap ada sebagai fallback kalau binding tidak
  // tersedia (dev lokal, unit test, deploy lama).
  //
  // `database_name` / `database_id` diverifikasi 2026-10-23 lewat
  // GET /d1/database/{id}: portfolio-template-prod, 19 tabel.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-template-prod",
      "database_id": "7a8b4eaa-d1cd-4912-9d1a-fafe86af4a5c"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "45637426c41046f985dfa29edccc3053"
    },
    {
      "binding": "NEXT_TAG_CACHE_KV",
      "id": "cb5634a164b64fe3842783c8ced942cf"
    }
  ],
  // Dipakai memory queue (open-next.config.ts) untuk memicu ISR revalidation lewat
  // service binding in-Workers, bukan fetch ke URL publik. Nama service = nama worker.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "portfolio-os-template"
    }
  ],
  // Cron harian 01:00 WIB (18:00 UTC). OpenNext tidak mengekspor handler
  // `scheduled`, jadi handler itu ditambahkan ke `.open-next/worker.js` oleh
  // `scripts/cloudflare/prepare-opennext-worker-output.js` setelah build, lalu
  // memanggil POST /api/cron/daily lewat service binding WORKER_SELF_REFERENCE.
  "triggers": {
    // ⚠️ Jadwal uji `* * * * *` pernah dipasang 2026-10-03 (deploy 942ee8a2) untuk
    // membuktikan fire pertama, tetapi 40 menit pengamatan TIDAK menghasilkan
    // satu pun invocation `scheduled`. Jadwal uji sudah dilepas kembali; lihat
    // `docs/tracker/logs/cron_worker_secrets_2026_10_03.md` bagian uji fire.
    "crons": ["0 18 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
