{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-os-template",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-28",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "portfolio-template-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "45637426c41046f985dfa29edccc3053"
    },
    {
      "binding": "NEXT_TAG_CACHE_KV",
      "id": "cb5634a164b64fe3842783c8ced942cf"
    }
  ],
  // Dipakai memory queue (open-next.config.ts) untuk memicu ISR revalidation lewat
  // service binding in-Workers, bukan fetch ke URL publik. Nama service = nama worker.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "portfolio-os-template"
    }
  ],
  // Cron harian 01:00 WIB (18:00 UTC). OpenNext tidak mengekspor handler
  // `scheduled`, jadi handler itu ditambahkan ke `.open-next/worker.js` oleh
  // `scripts/cloudflare/prepare-opennext-worker-output.js` setelah build, lalu
  // memanggil POST /api/cron/daily lewat service binding WORKER_SELF_REFERENCE.
  "triggers": {
    // ⚠️ Jadwal uji `* * * * *` pernah dipasang 2026-10-03 (deploy 942ee8a2) untuk
    // membuktikan fire pertama, tetapi 40 menit pengamatan TIDAK menghasilkan
    // satu pun invocation `scheduled`. Jadwal uji sudah dilepas kembali; lihat
    // `docs/tracker/logs/cron_worker_secrets_2026_10_03.md` bagian uji fire.
    "crons": ["0 18 * * *"]
  },
  // Batas subrequest per invokasi.
  //
  // Diperlukan oleh cron harian: Worker ini TIDAK punya binding D1, sehingga
  // setiap operasi D1 ditempuh keluar lewat fetch() ke api.cloudflare.com, yang
  // terhitung subrequest eksternal. `bootstrapD1Schema()` saja memakai 24
  // panggilan per isolate dingin, ditambah backup harian dan 2 tulisan hasil
  // probe — melewati batas 50 bawaan dan membuat tulisan gagal dengan pesan
  // "Too many subrequests by single Worker invocation" (terbukti 2026-10-23).
  //
  // Nilai 500 memberi ruang besar untuk cron sekaligus tetap membatasi runaway.
  // Kalau paket akun ternyata gratis (dibatasi 50), nilai ini akan di-clamp dan
  // kegagalannya terlihat lagi lewat `workerHealthRecordError` di respons cron.
  "limits": {
    "subrequests": 500
  },
  "observability": {
    "enabled": true
  }
}
