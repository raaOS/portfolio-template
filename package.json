{
  "name": "portfolio-shared",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/core/dev.js",
    "dev:webpack": "node scripts/core/dev.js --webpack",
    "build": "node scripts/utils/ensure-next-dev-not-running.js && next build",
    "build:clean": "node scripts/utils/ensure-next-dev-not-running.js && npm run clear-cache -- --force && next build",
    "start": "next start",
    "lint": "eslint src",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "check": "npm run format:check && npm run lint && npm test",
    "clear-cache": "node scripts/utils/clear-cache.js",
    "fix-webpack": "node scripts/utils/fix-webpack-cache.js",
    "fresh-start": "npm run clear-cache && npm run dev",
    "ultra-fresh": "npm run fix-webpack && npm run dev",
    "ultra-clean": "node scripts/utils/ultra-clean.js",
    "kill-cache": "node scripts/utils/kill-browser-cache.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e": "playwright test",
    "test:all": "npm test && npm run e2e",
    "pre-deploy": "node scripts/deploy/pre-deploy-check.js",
    "deploy": "node scripts/utils/ensure-next-dev-not-running.js && npm run pre-deploy && npm run cf:deploy",
    "client:new": "npx tsx scripts/onboarding/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "npx tsx scripts/maintenance/audit.ts",
    "site-scope:audit": "node scripts/maintenance/audit-site-scope.js",
    "cf:build": "node scripts/cloudflare/run-opennext-cloudflare-build.js",
    "cf:preview": "npm run cf:build && wrangler dev --env-file .env.local",
    "cf:deploy": "npm run cf:build && node scripts/cloudflare/run-opennext-cloudflare-deploy.js",
    "cf:typegen": "wrangler types cloudflare-env.d.ts --env-interface CloudflareEnv --include-runtime false",
    "cf:secrets": "npx tsx scripts/cloudflare/put-worker-secrets.ts",
    "cf:compat-audit": "node scripts/cloudflare/worker-compat-audit.js",
    "cf:doctor": "npx tsx scripts/cloudflare/product-bootstrap.ts",
    "cf:readiness": "npx tsx scripts/cloudflare/production-readiness.ts",
    "cf:bootstrap": "npx tsx scripts/cloudflare/product-bootstrap.ts --apply-schema",
    "cf:seed-demo": "npx tsx scripts/cloudflare/product-bootstrap.ts --seed-demo",
    "cf:live-check": "npx tsx scripts/cloudflare/product-bootstrap.ts --live-check",
    "backup:d1": "npx tsx scripts/cloudflare/backup-d1.ts",
    "backup:r2": "npx tsx scripts/cloudflare/backup-r2-site-media.ts",
    "restore:d1": "npx tsx scripts/cloudflare/restore-d1.ts",
    "restore:audit": "npx tsx scripts/cloudflare/audit-restore-integrity.ts",
    "restore:seed-drill": "npx tsx scripts/cloudflare/seed-restore-drill-project.ts",
    "db:bootstrap:d1": "npx tsx scripts/cloudflare/product-bootstrap.ts --apply-schema",
    "db:test": "npx tsx scripts/cloudflare/test-env.ts",
    "db:test:live": "npx tsx scripts/cloudflare/test-env.ts --live-check",
    "media:optimize-wallpapers": "node scripts/media/optimize-wallpapers.mjs",
    "media:fix-wallpaper-urls": "npx tsx scripts/cloudflare/fix-wallpaper-urls.ts",
    "media:audit-projects": "npx tsx scripts/cloudflare/audit-site-project-media.ts",
    "media:audit-wallpaper-videos": "node scripts/media/audit-wallpaper-videos.mjs",
    "r2:upload-ffmpeg": "npx tsx scripts/cloudflare/upload-ffmpeg-to-r2.ts",
    "r2:set-cors": "npx tsx scripts/cloudflare/set-r2-cors.ts",
    "release:audit": "node scripts/release/audit-release-package.js",
    "release:sale-readiness": "node scripts/release/audit-sale-readiness.js",
    "release:smoke": "node scripts/release/smoke-production.js",
    "monitoring:synthetic": "node scripts/monitoring/synthetic-production-check.js",
    "monitoring:synthetic:loop": "node scripts/monitoring/synthetic-24h-loop.js",
    "monitoring:verify-24h": "node scripts/monitoring/verify-24h-synthetic.js",
    "monitoring:verify-24h-slo": "node scripts/monitoring/verify-24h-slo.js",
    "load:multi-buyer": "node scripts/load/multi-buyer-load-test.js",
    "load:cleanup": "node scripts/load/cleanup-load-test-tenants.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1047.0",
    "@aws-sdk/s3-request-presigner": "^3.1047.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@lottiefiles/dotlottie-react": "^0.19.7",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-query": "^5.90.12",
    "@types/three": "^0.186.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "ffmpeg-static": "^5.3.0",
    "fuse.js": "^7.1.0",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lenis": "^1.3.17",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.542.0",
    "motion": "^12.38.0",
    "next": "^16.3.6",
    "next-view-transitions": "^0.3.5",
    "qrcode.react": "^4.2.0",
    "rc-slider": "^11.1.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-easy-crop": "^5.5.6",
    "react-masonry-css": "^1.0.16",
    "sharp": "^0.35.4",
    "swr": "^2.4.0",
    "tailwind-merge": "^3.3.1",
    "three": "^0.186.0",
    "uuid": "^13.0.0",
    "web-vitals": "^5.1.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.12",
    "@opennextjs/cloudflare": "^1.20.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dotenv": "^6.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20.19.33",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.19",
    "babel-plugin-react-compiler": "^1.0.0",
    "critters": "^0.0.23",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.12",
    "fast-check": "^3.23.2",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.22.3",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11",
    "wrangler": "^4.105.0"
  },
  "browserslist": {
    "production": [
      "chrome >= 92",
      "firefox >= 92",
      "safari >= 15",
      "edge >= 92"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "fast-xml-parser": "^5.5.9",
    "flatted": "^3.3.3",
    "undici": "^7.5.0",
    "postcss": "^8.5.28",
    "next": {
      "postcss": "^8.5.28"
    }
  }
}
